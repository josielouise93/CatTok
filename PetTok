<!DOCTYPE html>
<html>
<head>
    <title>🐱 CatTok</title>
    <style>
        * {
            box-sizing: border-box;
            font-family: Arial, sans-serif;
        }
        body {
            margin: 0;
            background: #ffe6f2;
            transition: .3s;
        }
        .dark {
            background: #17121c;
            color: white;
        }
        header {
            background: white;
            padding: 20px;
            text-align: center;
            position: sticky;
            top: 0;
            z-index: 5;
            box-shadow: 0 4px 6px rgba(0,0,0,0.05);
        }
        .dark header {
            background: #292033;
        }
        h1 {
            margin: 5px 0 15px 0;
            font-size: 45px;
            color: #ff4fa3;
        }
        input, textarea {
            padding: 12px;
            border-radius: 20px;
            border: 2px solid pink;
            margin: 5px;
            outline: none;
        }
        button {
            background: #ff4fa3;
            color: white;
            border: 0;
            padding: 10px 15px;
            border-radius: 20px;
            cursor: pointer;
            font-weight: bold;
            transition: transform 0.2s;
        }
        button:hover {
            transform: scale(1.05);
        }
        .user-panel {
            background: #fff0f7;
            padding: 10px;
            border-radius: 15px;
            display: inline-block;
            margin-bottom: 10px;
            border: 1px dashed #ff4fa3;
        }
        .dark .user-panel {
            background: #3a2e47;
            border-color: #ff4fa3;
        }
        .feed {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 30px;
            padding: 30px;
        }
        .cat {
            background: white;
            width: 360px;
            border-radius: 25px;
            overflow: hidden;
            box-shadow: 0 10px 20px rgba(0,0,0,0.1);
        }
        .dark .cat {
            background: #292033;
        }
        .cat img {
            width: 100%;
            height: 350px;
            object-fit: cover;
        }
        .info {
            padding: 15px;
        }
        .name {
            font-size: 24px;
            color: #ff4fa3;
            font-weight: bold;
        }
        .owner-tag {
            font-size: 12px;
            color: #666;
            margin-bottom: 10px;
        }
        .dark .owner-tag {
            color: #bbb;
        }
        .badge {
            background: #ffd1e8;
            padding: 5px 10px;
            border-radius: 10px;
            font-size: 12px;
            color: #ff1493;
        }
        #dex {
            text-align: center;
            font-size: 20px;
            margin-top: 15px;
        }
        #uploadBox {
            text-align: center;
            padding: 20px;
            background: rgba(25px, 255, 255, 0.5);
        }
        .messageBox {
            margin-top: 15px;
            border-top: 1px solid #eee;
            padding-top: 15px;
        }
        .messages-list {
            margin-top: 10px;
            max-height: 150px;
            overflow-y: auto;
        }
        .message {
            background: #f0f0f0;
            padding: 8px 12px;
            border-radius: 15px;
            margin-top: 5px;
            font-size: 13px;
            text-align: left;
        }
        .dark .message {
            background: #443650;
        }
        .msg-sender {
            font-weight: bold;
            color: #ff4fa3;
            font-size: 11px;
            display: block;
        }
        .email-btn {
            background: #4a90e2;
            font-size: 12px;
            padding: 5px 10px;
            margin-top: 5px;
        }
    </style>
</head>
<body>

<header>
    <h1>🐱 CatTok</h1>
    
    <!-- Account Section -->
    <div class="user-panel" id="userPanel">
        <div id="loginForm">
            <input id="usernameInput" placeholder="Your Name (e.g. Josie Goulet)">
            <input id="emailInput" placeholder="Your Email">
            <button onclick="registerAccount()">Login / Create Account</button>
        </div>
        <div id="profileDisplay" style="display:none;">
            Logged in as: <strong id="currentUserDisplay" style="color:#ff4fa3"></strong> 
            <button onclick="logout()" style="background:#aaa; padding:5px 10px; font-size:12px;">Change Account</button>
        </div>
    </div>
    <br>

    <input id="search" placeholder="Search cats..." onkeyup="searchCats()">
    <br><br>
    <button onclick="toggleDark()"> 🌙 Theme </button>
    <button onclick="openUpload()"> ➕ Add Cat </button>
</header>

<div id="dex">
    🐾 CatDex Total: <span id="count">0</span>
</div>

<div id="uploadBox" style="display:none">
    <h2>Create your cat!</h2>
    <input id="catName" placeholder="Cat name">
    <br>
    <input type="file" id="catImage" accept="image/*">
    <br>
    <textarea id="catBio" placeholder="Funny cat bio"></textarea>
    <br>
    <button onclick="createCat()"> Create 🐱 </button>
</div>

<div class="feed" id="feed"></div>

<script>
// Application State Engine
let currentUser = JSON.parse(localStorage.getItem('cattok_user')) || null;
let cats = JSON.parse(localStorage.getItem('cattok_cats')) || [];

// Initialize Page Elements
window.onload = function() {
    updateUserUI();
    if(cats.length === 0) {
        // Factory Default Cats
        cats = [
            {
                id: "default1",
                name: "Mochi",
                bio: "🍞 Professional loaf who steals blankets",
                img: "https://placecats.com",
                ownerName: "System",
                ownerEmail: "admin@cattok.com",
                messages: []
            },
            {
                id: "default2",
                name: "Beans",
                bio: "⚡ Zoomie champion and box destroyer",
                img: "https://placecats.com",
                ownerName: "System",
                ownerEmail: "admin@cattok.com",
                messages: []
            }
        ];
        saveToLocalStorage();
    }
    renderFeed();
};

// Account Framework Logic
function registerAccount() {
    let name = document.getElementById("usernameInput").value.trim();
    let email = document.getElementById("emailInput").value.trim();
    
    if(!name || !email) {
        alert("Please enter both your name and email address to log in!");
        return;
    }
    
    currentUser = { name: name, email: email };
    localStorage.setItem('cattok_user', JSON.stringify(currentUser));
    updateUserUI();
    renderFeed(); // Re-render feed to apply correct visibility filters
}

function logout() {
    currentUser = null;
    localStorage.removeItem('cattok_user');
    updateUserUI();
    renderFeed();
}

function updateUserUI() {
    if(currentUser) {
        document.getElementById("loginForm").style.display = "none";
        document.getElementById("profileDisplay").style.display = "block";
        document.getElementById("currentUserDisplay").innerText = currentUser.name;
    } else {
        document.getElementById("loginForm").style.display = "block";
        document.getElementById("profileDisplay").style.display = "none";
    }
}

// Storage Operations
function saveToLocalStorage() {
    localStorage.setItem('cattok_cats', JSON.stringify(cats));
}

function openUpload() {
    let box = document.getElementById("uploadBox");
    box.style.display = (box.style.display === "none") ? "block" : "none";
}

// Media Pipeline & Cat Registry
function createCat() {
    if(!currentUser) {
        alert("You must create an account first before posting your cat!");
        return;
    }

    let name = document.getElementById("catName").value;
    let bio = document.getElementById("catBio").value;
    let file = document.getElementById("catImage").files[0];

    if(!name || !file) {
        alert("Add a name and photo!");
        return;
    }

    let reader = new FileReader();
    reader.onload = function(e) {
        let newCat = {
            id: "cat_" + Date.now(),
            name: name,
            bio: bio,
            img: e.target.result, // base64 encoded data saves inside localstorage
            ownerName: currentUser.name,
            ownerEmail: currentUser.email,
            messages: []
        };
        
        cats.unshift(newCat);
        saveToLocalStorage();
        renderFeed();
        
        // Reset Inputs
        document.getElementById("catName").value = "";
        document.getElementById("catBio").value = "";
        document.getElementById("catImage").value = "";
        document.getElementById("uploadBox").style.display = "none";
    };
    reader.readAsDataURL(file);
}

// Render Framework Engine
function renderFeed() {
    let feed = document.getElementById("feed");
    feed.innerHTML = "";
    document.getElementById("count").innerHTML = cats.length;

    cats.forEach(cat => {
        let card = document.createElement("div");
        card.className = "cat";
        
        // Generate secure messaging container markup
        let messagingHTML = '';
        if(currentUser) {
            // Filter Messages securely: show messages sent by current user OR received if user is the owner
            let filteredMessages = cat.messages.filter(msg => 
                msg.senderEmail === currentUser.email || cat.ownerEmail === currentUser.email
            );

            let messagesFeedHTML = filteredMessages.map(msg => `
                <div class="message">
                    <span class="msg-sender">From: ${msg.senderName} (${msg.senderEmail})</span>
                    💬 ${msg.text}
                </div>
            `).join('');

            messagingHTML = `
                <div class="messageBox">
                    <p style="font-size:12px; margin:5px 0; color:#888;">🔒 Private Chat Box</p>
Use code with caution.Send 💌📧 Open Email App${messagesFeedHTML}; } else { messagingHTML = ⚠️ Create an account above to privately message the owner.`;}card.innerHTML = <img src="${cat.img}"> <div class="info"> <div class="name">${cat.name} 🐱</div> <div class="owner-tag">Owner: 👤 ${cat.ownerName}</div> <p>${cat.bio}</p> <span class="badge"> ✨ Cat Star </span> ${messagingHTML} </div>;feed.appendChild(card);});}// Communication Handlersfunction sendPrivateMessage(catId) {if(!currentUser) return;let inputField = document.getElementById(msg_input_${catId});let text = inputField.value.trim();if(!text) return;let targetCat = cats.find(c => c.id === catId);if(targetCat) {// Package the contextual data objecttargetCat.messages.push({senderName: currentUser.name,senderEmail: currentUser.email,text: text,timestamp: new Date().getTime()});saveToLocalStorage();renderFeed();}}// Utility Framework Featuresfunction toggleDark() {document.body.classList.toggle("dark");}function searchCats() {let text = document.getElementById("search").value.toLowerCase();let cards = document.querySelectorAll(".cat");cards.forEach(card => {if(card.innerText.toLowerCase().includes(text)) {card.style.display = "block";} else {card.style.display = "none";}});}
